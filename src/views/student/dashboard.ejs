<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Dashboard Mahasiswa</h1>
    <p class="page-subtitle">Selamat datang kembali, <strong><%= student ? student.full_name : user.full_name %></strong>!</p>
  </div>
  <div>
    <a href="/student/assignments" class="btn btn-primary">📤 Kumpulkan Tugas</a>
  </div>
</div>

<!-- Profil Singkat & Status Akademik -->
<div class="grid-3" style="margin-bottom: 1.5rem;">
  <div class="stat-card">
    <div class="stat-icon">🆔</div>
    <div>
      <div class="stat-val"><%= student ? student.nim : '-' %></div>
      <div class="stat-label">Nomor Induk Mahasiswa (NIM)</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">📚</div>
    <div>
      <div class="stat-val"><%= enrollments.length %></div>
      <div class="stat-label">Mata Kuliah Diambil</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon">👨‍🏫</div>
    <div>
      <div class="stat-val" style="font-size: 1.1rem;"><%= student && student.advisor_name ? student.advisor_name : 'Belum Ditentukan' %></div>
      <div class="stat-label">Dosen Pembimbing Akademik</div>
    </div>
  </div>
</div>

<!-- Daftar Mata Kuliah & Nilai Sementara -->
<div class="card">
  <div class="card-title">
    <span>📖 Mata Kuliah Semester Berjalan</span>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Kode</th>
          <th>Nama Mata Kuliah</th>
          <th>SKS</th>
          <th>Dosen Pengampu</th>
          <th>Nilai Akhir</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (enrollments.length === 0) { %>
          <tr>
            <td colspan="6" style="text-align: center; color: var(--text-muted);">Belum ada mata kuliah yang diambil.</td>
          </tr>
        <% } else { %>
          <% enrollments.forEach(e => { %>
            <tr>
              <td><code><%= e.code %></code></td>
              <td><strong><%= e.course_name %></strong></td>
              <td><%= e.credits %> SKS</td>
              <td><%= e.lecturer_name %></td>
              <td>
                <% if (e.letter_grade) { %>
                  <span class="badge-tag" style="background-color: rgba(16, 185, 129, 0.2); color: #6ee7b7; font-weight: bold;">
                    <%= e.letter_grade %> (<%= e.final_score %>)
                  </span>
                <% } else { %>
                  <span style="color: var(--text-muted);">Belum Dinilai</span>
                <% } %>
              </td>
              <td>
                <span class="badge-tag" style="background-color: rgba(59, 130, 246, 0.2); color: #93c5fd;">
                  <%= e.status.toUpperCase() %>
                </span>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Tugas Mendatang -->
<div class="card">
  <div class="card-title">
    <span>📝 Tugas & Praktikum Akademik</span>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Mata Kuliah</th>
          <th>Judul Tugas</th>
          <th>Batas Waktu</th>
          <th>Status Pengumpulan</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (assignments.length === 0) { %>
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-muted);">Tidak ada tugas aktif saat ini.</td>
          </tr>
        <% } else { %>
          <% assignments.forEach(a => { %>
            <tr>
              <td><code><%= a.course_code %></code></td>
              <td><strong><%= a.title %></strong></td>
              <td style="color: var(--warning-amber);"><%= new Date(a.due_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td>
                <% if (a.submission_id) { %>
                  <span class="badge-tag" style="background-color: rgba(16, 185, 129, 0.2); color: #6ee7b7;">Terkumpul</span>
                <% } else { %>
                  <span class="badge-tag" style="background-color: rgba(239, 68, 68, 0.2); color: #fca5a5;">Belum Mengumpulkan</span>
                <% } %>
              </td>
              <td>
                <a href="/student/assignments" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
                  <%= a.submission_id ? 'Lihat / Ubah' : 'Unggah' %>
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
