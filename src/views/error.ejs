<%- include('partials/header') %>

<div style="max-width: 600px; margin: 3rem auto; text-align: center;">
  <div class="card" style="padding: 2.5rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">
      <% if (statusCode === 403) { %>🚫<% } else if (statusCode === 404) { %>🔍<% } else if (statusCode === 429) { %>⏱️<% } else { %>⚠️<% } %>
    </div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.75rem;"><%= title %></h1>
    <p style="color: var(--text-secondary); margin-bottom: 1.5rem;"><%= message %></p>

    <div style="display: flex; justify-content: center; gap: 1rem;">
      <a href="javascript:history.back()" class="btn btn-secondary">Kembali</a>
      <a href="/lab" class="btn btn-primary">Ke Dashboard Lab</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
