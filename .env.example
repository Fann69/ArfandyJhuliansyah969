# =====================================================================
# KONFIGURASI PORTAL KAMPUS FIKTIF PRAKTIKUM KEAMANAN WEB
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi lokal Anda.
# JANGAN MENYIMPAN KREDENSIAL ATAU SECRET ASLI DI REPOSITORI PUBLIK.
# =====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (Gunakan string acak panjang di lingkungan lokal)
SESSION_SECRET=kunci-rahasia-sesi-laboratorium-praktikum-keamanan-2026

# Database Client: 'mysql' (XAMPP/phpMyAdmin) atau 'sqlite' (Zero-config otomatis)
DB_CLIENT=mysql

# MySQL Configuration (Default XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_kampus_lab

# Mode Default Laboratorium: 'vulnerable' (Rentan) atau 'secure' (Aman)
LAB_MODE_DEFAULT=vulnerable

# Lokasi Unggahan Berkas Tugas
UPLOAD_DIR=uploads
